  "changelog": {
    "v5_0": {
      "released": "2025-05-30",
      "major_changes": [
        "Chapter structure rebuilt: 17 chapters, renumbered from 4.x",
        "345 requirements",
        "Levels are priority-based and no longer carry the 4.x names",
        "OAuth and OIDC promoted to its own chapter (V10)",
        "WebRTC added as V17",
        "Encoding and Sanitization moved to V1; Authentication moved from V2 to V6"
      ],
      "migration": "https://github.com/OWASP/ASVS/blob/master/5.0/en/0x05-For-Users-Of-4.0.md"
    }
  },
